# Copy to backend/.env and adjust. All variables are optional.
ZENITH_ENVIRONMENT=development
ZENITH_DEBUG=false
ZENITH_DATABASE_URL=sqlite:///./zenith.db
ZENITH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Briefing display/shift time zone (IANA name); storage is always UTC
ZENITH_BRIEFING_TIMEZONE=UTC
# Executive-summary wording: deterministic (default, no model) or ollama (optional local model, validated, falls back)
ZENITH_REASONING_PROVIDER=deterministic
